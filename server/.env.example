# Copy placeholders only. Keep the existing .env values intact.
MONGODB_URI=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Express publishable key. Legacy NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is ignored.
CLERK_PUBLISHABLE_KEY=
PORT=4000
NODE_ENV=development
# Local development only; production requires exact HTTPS frontend origins.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Informational intended admin; this does NOT grant access.
ADMIN_EMAIL=muaddhalsway@gmail.com
ORDER_CREATION_ENABLED=false
RESERVATION_CREATION_ENABLED=false

# Optional DNS server IP list for Atlas SRV/TXT lookups; leave unset normally.
MONGODB_DNS_SERVERS=
# Explicit database selection, preserving the URI and its other options.
MONGODB_DB_NAME=thetable

# Required when production ordering is enabled; leave ordering disabled during first deployment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
