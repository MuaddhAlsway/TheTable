# Public frontend configuration only. Never paste server secret values here.
VITE_CLERK_PUBLISHABLE_KEY=
# Include /api/v1; use the Render origin in Vercel production settings.
VITE_API_URL=https://thetable-50sf.onrender.com/api/v1

# Optional public Stripe key. Hosted Checkout is created by the server; never add server secrets here.
VITE_STRIPE_PUBLISHABLE_KEY=

# Public CUSTOMER website origin for printed table QR codes, never the backend API URL.
VITE_PUBLIC_SITE_URL=https://the-table-khaki.vercel.app
